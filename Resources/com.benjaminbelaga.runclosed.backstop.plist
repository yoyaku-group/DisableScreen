<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ADR 024 recovery backstop — a PER-USER LaunchAgent registered through
         SMAppService.agent(plistName:). Lives in the app bundle at
         Contents/Library/LaunchAgents/. The Label MUST match
         RunClosedBackstopDescriptor.agentLabel. -->
    <key>Label</key>
    <string>com.benjaminbelaga.runclosed.backstop</string>

    <!-- BundleProgram — the path is relative to the bundle root, the same
         rule the helper daemon follows (Apple: "make the path relative to the
         bundle"). The value MUST match
         RunClosedBackstopDescriptor.bundleProgramRelativePath (a unit test
         asserts this). -->
    <key>BundleProgram</key>
    <string>Contents/MacOS/runclosed-cli</string>

    <!-- ProgramArguments — argv[0] is the program name, then the one
         protective command. `--backstop` is mandatory: without it `recover`
         refuses (exit 64), so a hand-edited plist cannot turn this job into a
         bare mutation. -->
    <key>ProgramArguments</key>
    <array>
        <string>runclosed-cli</string>
        <string>recover</string>
        <string>--backstop</string>
    </array>

    <!-- Every minute. A crashed app therefore costs at most ~60 s of an
         unprotected awake Mac before the deadline or the battery rule fires. -->
    <key>StartInterval</key>
    <integer>60</integer>

    <!-- Run once at load as well, so registering the agent takes effect
         immediately instead of at the next interval. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- No KeepAlive: the job is a one-shot every 60 s, and KeepAlive on a
         short-lived process would respawn it in a tight loop. -->
    <key>ProcessType</key>
    <string>Background</string>

    <!-- It writes nothing but the audit line; it never needs to be reniced
         below the system's background policy. -->
    <key>LowPriorityIO</key>
    <true/>

    <!-- launchd owns the agent's stdout/stderr; without these two keys a
         refused run (the macOS 26 `notFound` state, a `pmset` that fails in
         this context) is DISCARDED, and the operator has no way to see why the
         net is not protecting them. Diagnostics go to a file rather than the
         audit log, which only records actions.

         NOT /tmp: that directory is world-writable and sticky, so another
         local account could pre-create the name as a symlink to any file this
         user can write (a shell profile, an authorized_keys) — launchd opens
         the path AS THIS USER, so the write lands with our privileges. An
         absolute path under ~/Library/Logs is not pre-creatable by anyone
         else. launchd does not expand `~` in these keys, so the absolute form
         is required; a unit test pins it.

         KNOWN LIMIT (review round 13): `__HOME__` is substituted at BUILD time,
         so these two paths name the build account's home. The agent itself is
         registered per user with SMAppService, so on a machine where RunClosed
         was installed by another account, the agent runs for THIS user but
         launchd writes both files into the builder's home — either failing the
         open (silent loss of diagnostics) or, worse, writing into a directory
         this user may not own. It is not fixable in the template: a plist
         inside a signed bundle is fixed bytes, and launchd expands no variable
         here. The correct fix is to stop using these keys and let the agent
         forward its own diagnostics to a per-user path resolved at RUNTIME
         (Logs/RunClosed under NSHomeDirectory, which prepareLogDirectory()
         already creates); that is a follow-up, tracked rather than pretended
         done. It affects only the diagnostics of a protective agent, not its
         protective behaviour: the audit log (recovery_audit.jsonl) is written
         by the agent itself under its own home and is unaffected. -->
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/RunClosed/backstop.err.log</string>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/RunClosed/backstop.out.log</string>
</dict>
</plist>
